{
    "testbed-04-ospv2": {
        "devices": [
            {
                "name": "board",
                "type": "prplos_board",
                "connection_type": "serial",
                "conn_cmd": ["picocom -b 115200 /dev/dut-console"],
                "shell_prompt": ["root@[\\w()]+:[^ ]+ "],
                "labgrid": {
                    "config_file": ".testbed/labgrid/testbed-04.yaml",
                    "target": "mxl25641-hdk-6-emmc"
                },
                "network": {
                    "lan_ip": "192.168.1.1",
                    "test_host": "192.168.1.2",
                    "lan_alias": "lan",
                    "lan_iface": "br-lan",
                    "wan_iface": "eth1"
                },
                "ssh": {
                    "username": "root",
                    "port": 22,
                    "connect_timeout": 30,
                    "connect_attempts": 3
                },
                "tftp_dir": "/var/lib/tftpboot"
            }
        ]
    }
}
