#!/bin/sh /etc/rc.common

USE_PROCD=1

NAME="tr181-display-app-direct"

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/prpl_lvgl_demo_app
    procd_set_param env WAYLAND_DISPLAY="$(cat /tmp/cramtest-socket1)" TEXT_DISPLAY="CRAM TEST DIRECT"
    procd_close_instance
}
