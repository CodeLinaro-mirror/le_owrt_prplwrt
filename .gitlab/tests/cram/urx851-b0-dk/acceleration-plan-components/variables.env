### Global variables
CLI_JSON="ba-cli -l -j"
CLI="ba-cli"
UPDATE_TIMER="20"
UNINSTALL_TIMER="15"
INSTALL_TIMER="10"
EXEC_ENV="generic"
EXEC_ENV_PARAM="ExecutionEnvRef = \"${EXEC_ENV}\""
UUID="00000000-0000-5000-b000-000000000001"
UUID_PARAM="UUID = \"${UUID}\""
UUID_FILTER="UUID == \"${UUID}\""
EXEC_ENV_FILTER="Name == \"${EXEC_ENV}\""
URL_PRPLOS_V1_PARAM="URL = \"docker://registry.gitlab.com/prpl-foundation/prplos/prplos/prplos/lcm-test-x86-64:prplos-v1\""
URL_PRPLOS_V2_PARAM="URL = \"docker://registry.gitlab.com/prpl-foundation/prplos/prplos/prplos/lcm-test-x86-64:prplos-v2\""
LINKEDUUID_FILTER="LinkedUUID == \"${UUID}\""


### Network configuration variables
NETWORKCONFIG_PARAM="NetworkConfig = {AccessInterfaces = [{Reference = \"Lan\"}]}"
NETWORK_INTERFACE="lcm0"
NETWORK_INTERFACE_FILTER="Name == \"${NETWORK_INTERFACE}\""


### Privilege configuration variables
PRIVILEGED_PARAM="Privileged = true"
UNPRIVILEGED_PARAM="Privileged = false"
NUM_UIDS_PARAM="NumRequiredUIDs = 10"


## USP configuration variables
FULL_ACCESS_ROLE="Full Access"
AVAILABLE_ROLES_PARAM="AvailableRoles = \"${FULL_ACCESS_ROLE}\""
REQUIRED_ROLES_PARAM="RequiredRoles = \"${FULL_ACCESS_ROLE}\""

## ApplicationDara configuration variables
APPLICATION_DATA_PARAM="ApplicationData = [{Name = \"Volume1\", Capacity = 1, Retain = \"UntilStopped\", AccessPath = \"/volume1\"}, {Name = \"Volume2\", Capacity = 1, Retain = \"Forever\", AccessPath = \"/volume2\"}]"
