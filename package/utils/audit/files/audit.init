#!/bin/sh /etc/rc.common
# Copyright (c) 2014 OpenWrt.org

START=11

USE_PROCD=1
PROG=/usr/sbin/auditd

start_service() {
	# Increase audit backlog early (before rules / AppArmor)
	if command -v /usr/sbin/auditctl >/dev/null 2>&1; then
		/usr/sbin/auditctl -b 16384
		/usr/sbin/auditctl -r 0
	fi
	mkdir -p /var/log/audit
	procd_open_instance
	procd_set_param command "$PROG" -n
	procd_set_param respawn
	procd_close_instance
	test -f /etc/audit/rules.d/audit.rules && /usr/sbin/auditctl -R /etc/audit/rules.d/audit.rules
}
