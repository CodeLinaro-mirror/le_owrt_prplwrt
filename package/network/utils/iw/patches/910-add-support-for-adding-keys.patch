From 8fbdc972c7527cb00fdfb01ed5793f9fd54341fa Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Rapha=C3=ABl=20M=C3=A9lotte?= <raphael.melotte@mind.be>
Date: Mon, 29 Aug 2022 13:42:12 +0200
Subject: [PATCH 2/6] iw: add support for adding keys
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Signed-off-by: Raphaël Mélotte <raphael.melotte@mind.be>
---
 keys.c | 100 +++++++++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 100 insertions(+)

diff --git a/keys.c b/keys.c
index 5d7c577..7af6749 100644
--- a/keys.c
+++ b/keys.c
@@ -76,3 +76,103 @@ static int handle_get_key(struct nl80211_state *state,
 COMMAND(key, get, "<key index> <MAC address>",
 	NL80211_CMD_GET_KEY, 0, CIB_NETDEV, handle_get_key,
 	"Retrieve a key and key sequence.\n");
+
+static int handle_add_key(struct nl80211_state *state,
+			  struct nl_msg *msg, int argc, char **argv,
+			  enum id_input id)
+{
+	size_t len;
+	char buf[2048];
+	char *end;
+	unsigned char mac[6];
+	struct nl_msg *key_msg;
+	int err = -EINVAL;
+
+	key_msg = nlmsg_alloc();
+	if (!key_msg)
+		return -ENOMEM;
+
+	/* key index */
+	if (argc) {
+		nla_put_u8(msg, NL80211_ATTR_KEY_IDX, strtoul(argv[0], &end, 10));
+		argv++;
+		argc--;
+	}
+
+	/* mac */
+	if (argc) {
+		if (mac_addr_a2n(mac, argv[0]) == 0) {
+			NLA_PUT(msg, NL80211_ATTR_MAC, 6, mac);
+			argv++;
+			argc--;
+			nla_put_u32(msg, NL80211_ATTR_KEY_TYPE, NL80211_KEYTYPE_PAIRWISE);
+		}
+	} else {
+		nla_put_u32(msg, NL80211_ATTR_KEY_TYPE, NL80211_KEYTYPE_GROUP);
+	}
+
+	/* key */
+	if (argc) {
+		len = strlen(argv[0]);
+		if (!len || (len % 2)) {
+			err = -EINVAL;
+			goto nla_put_failure;
+		}
+
+		if (!hex2bin(&argv[0][0], buf)) {
+			err = -EINVAL;
+			goto nla_put_failure;
+		}
+
+		NLA_PUT(msg, NL80211_ATTR_KEY_DATA, (len / 2), &buf);
+		argv++;
+		argc--;
+	}
+
+	/* seq */
+	if (argc) {
+		len = strlen(argv[0]);
+		if (!len || (len % 2)) {
+			err = -EINVAL;
+			goto nla_put_failure;
+		}
+
+		if (!hex2bin(&argv[0][0], buf)) {
+			err = -EINVAL;
+			goto nla_put_failure;
+		}
+
+		NLA_PUT(msg, NL80211_ATTR_KEY_SEQ, (len / 2), &buf);
+		argv++;
+		argc--;
+	}
+
+	/* cipher (default is CCMP) */
+	if (argc) {
+		len = strlen(argv[0]);
+		if (!len || (len % 2)) {
+			err = -EINVAL;
+			goto nla_put_failure;
+		}
+
+		if (!hex2bin(&argv[0][0], buf)) {
+			err = -EINVAL;
+			goto nla_put_failure;
+		}
+
+		NLA_PUT(msg, NL80211_ATTR_KEY_CIPHER, (len / 2), &buf);
+		argv++;
+		argc--;
+	} else {
+		nla_put_u32(msg, NL80211_ATTR_KEY_CIPHER, 0x000FAC04);
+	}
+
+	err = 0;
+
+nla_put_failure:
+	nlmsg_free(key_msg);
+	return err;
+}
+COMMAND(key, add, "<key index> <MAC> <key> <key sequence> [cipher]",
+	NL80211_CMD_NEW_KEY, 0, CIB_NETDEV, handle_add_key,
+	"Add a new key.\n");
-- 
