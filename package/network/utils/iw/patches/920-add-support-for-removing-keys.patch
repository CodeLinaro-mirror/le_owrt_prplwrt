From d6bbbfcf55cec861d3c546982c31c2e835b774e4 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Rapha=C3=ABl=20M=C3=A9lotte?= <raphael.melotte@mind.be>
Date: Wed, 31 Aug 2022 09:36:55 +0200
Subject: [PATCH 3/6] iw: add support for removing keys
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Signed-off-by: Raphaël Mélotte <raphael.melotte@mind.be>
---
 keys.c | 43 +++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 43 insertions(+)

diff --git a/keys.c b/keys.c
index 7af6749..b400b5b 100644
--- a/keys.c
+++ b/keys.c
@@ -176,3 +176,46 @@ nla_put_failure:
 COMMAND(key, add, "<key index> <MAC> <key> <key sequence> [cipher]",
 	NL80211_CMD_NEW_KEY, 0, CIB_NETDEV, handle_add_key,
 	"Add a new key.\n");
+
+static int handle_del_key(struct nl80211_state *state,
+			  struct nl_msg *msg, int argc, char **argv,
+			  enum id_input id)
+{
+	char *end;
+	unsigned char mac[6];
+	struct nl_msg *key_msg;
+	int err = -EINVAL;
+
+	key_msg = nlmsg_alloc();
+	if (!key_msg)
+		return -ENOMEM;
+
+
+	/* key index */
+	if (argc) {
+		nla_put_u8(msg, NL80211_ATTR_KEY_IDX, strtoul(argv[0], &end, 10));
+		argv++;
+		argc--;
+	}
+
+	/* mac */
+	if (argc) {
+		if (mac_addr_a2n(mac, argv[0]) == 0) {
+			NLA_PUT(msg, NL80211_ATTR_MAC, 6, mac);
+			argv++;
+			argc--;
+			nla_put_u32(msg, NL80211_ATTR_KEY_TYPE, NL80211_KEYTYPE_PAIRWISE);
+		}
+	} else {
+		nla_put_u32(msg, NL80211_ATTR_KEY_TYPE, NL80211_KEYTYPE_GROUP);
+	}
+
+	err = 0;
+
+nla_put_failure:
+	nlmsg_free(key_msg);
+	return err;
+}
+COMMAND(key, del, "<key index> <MAC address>",
+	NL80211_CMD_DEL_KEY, 0, CIB_NETDEV, handle_del_key,
+	"Delete a key.\n");
-- 
