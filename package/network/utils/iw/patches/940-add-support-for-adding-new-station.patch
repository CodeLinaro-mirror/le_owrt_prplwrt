Still todo: capabilities and P2P PS.

Signed-off-by: Raphaël Mélotte <raphael.melotte@mind.be>
---
 station.c | 76 +++++++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 76 insertions(+)

diff --git a/station.c b/station.c
index e1477ef..6a12ae0 100644
--- a/station.c
+++ b/station.c
@@ -824,3 +824,79 @@ static int handle_station_dump(struct nl80211_state *state,
 COMMAND(station, dump, "[-v]",
 	NL80211_CMD_GET_STATION, NLM_F_DUMP, CIB_NETDEV, handle_station_dump,
 	"List all stations known, e.g. the AP on managed interfaces");
+
+static int handle_station_new(struct nl80211_state *state,
+			       struct nl_msg *msg,
+			       int argc, char **argv,
+			       enum id_input id)
+{
+	size_t len;
+	char buf[2048];
+	char *end;
+	unsigned char mac[6];
+	struct nl_msg *key_msg;
+	int err = -EINVAL;
+
+	key_msg = nlmsg_alloc();
+	if (!key_msg)
+		return -ENOMEM;
+
+	/* mac */
+	if (argc) {
+		if (mac_addr_a2n(mac, argv[0]) == 0) {
+			NLA_PUT(msg, NL80211_ATTR_MAC, 6, mac);
+			argv++;
+			argc--;
+		}
+	}
+
+	/* listen interval */
+	if (argc) {
+		nla_put_u16(msg, NL80211_ATTR_STA_LISTEN_INTERVAL, strtoul(argv[0], &end, 10));
+		argv++;
+		argc--;
+	}
+
+	/* supported rates */
+	if (argc) {
+		len = strlen(argv[0]);
+		if (!len || (len % 2)) {
+			err = -EINVAL;
+			goto nla_put_failure;
+		}
+
+		if (!hex2bin(&argv[0][0], buf)) {
+			err = -EINVAL;
+			goto nla_put_failure;
+		}
+
+		NLA_PUT(msg, NL80211_ATTR_STA_SUPPORTED_RATES, (len / 2), &buf);
+		argv++;
+		argc--;
+	}
+
+	/* AID */
+	if (argc) {
+		nla_put_u16(msg, NL80211_ATTR_STA_AID, strtoul(argv[0], &end, 10));
+		argv++;
+		argc--;
+	}
+
+	/* flags2 */
+	if (argc) {
+		nla_put_u64(msg, NL80211_ATTR_STA_FLAGS2, strtoul(argv[0], &end, 10));
+		argv++;
+		argc--;
+	}
+	// TODO add sta capabilities and P2P PS:
+	nla_put_u16(msg, NL80211_ATTR_STA_CAPABILITY, 0);
+	nla_put_u8(msg, NL80211_ATTR_STA_SUPPORT_P2P_PS, 0);
+	err = 0;
+
+ nla_put_failure:
+	nlmsg_free(key_msg);
+	return err;
+}
+COMMAND(station, new, "<MAC> <listen_interval> <supported_rates> <aid> <flags>",
+	NL80211_CMD_NEW_STATION, 0, CIB_NETDEV, handle_station_new,
+	"Add a new station\n.");
