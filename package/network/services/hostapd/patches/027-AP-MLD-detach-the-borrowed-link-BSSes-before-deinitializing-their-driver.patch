@@ -1572,6 +1576,7 @@
 			 * invalidate links that made it onto mld->links. */
 			if (drv_priv_borrowed) {
 				hapd->drv_priv = NULL;
+				hapd->drv_owner_iface = NULL;
 				hapd->interface_added = 0;
 			}
 			return -1;
@@ -2148,6 +2153,7 @@
 	for (i = 1; i < iface->num_bss; i++) {
 		iface->bss[i]->driver = hapd->driver;
 		iface->bss[i]->drv_priv = hapd->drv_priv;
+		iface->bss[i]->drv_owner_iface = hapd->drv_owner_iface;
 	}
 
 	if (hostapd_validate_bssid_configuration(iface))
@@ -3114,6 +3120,24 @@
 {
 	size_t j;
 	wpa_printf(MSG_DEBUG, "%s(%p)", __func__, iface);
+#ifdef CONFIG_IEEE80211BE
+	/* A BSS elsewhere that still names this interface as the owner of its
+	 * driver runs on a driver that was left alive by
+	 * hostapd_cleanup_driver(); nobody owns that driver any more. */
+	if (iface->interfaces) {
+		size_t i;
+
+		for (i = 0; i < iface->interfaces->count; i++) {
+			struct hostapd_iface *other = iface->interfaces->iface[i];
+
+			for (j = 0; other && other != iface && j < other->num_bss;
+			     j++) {
+				if (other->bss[j]->drv_owner_iface == iface)
+					other->bss[j]->drv_owner_iface = NULL;
+			}
+		}
+	}
+#endif /* CONFIG_IEEE80211BE */
 	for (j = 0; j < iface->num_bss; j++) {
 		if (!iface->bss)
 			break;
@@ -3517,6 +3541,73 @@
 }
 
 
+/**
+ * hostapd_remove_drv_borrowers - Remove the BSSes of other interfaces that
+ * run on this interface's driver
+ * @iface: Interface whose driver is about to be deinitialized
+ *
+ * A non-first link BSS of an AP MLD has no driver context of its own:
+ * hostapd_setup_bss() and hostapd_driver_init() copy drv_priv from the first
+ * BSS of the MLD, which created it on the driver of its own interface. When
+ * that interface's first BSS is not an AP MLD link, hostapd_cleanup_driver()
+ * deinitializes the whole driver and every such context goes away with it,
+ * but the BSSes of the other interfaces that share the context are not told
+ * about it and would keep using a freed pointer.
+ *
+ * Remove those BSSes first, while the driver is still alive, the same way a
+ * REMOVE of that BSS would: their link is removed from the kernel and from
+ * the MLD and their control interface is closed. A first BSS that shares such
+ * a context takes its whole interface down (DISABLE) instead. The BSSes are
+ * identified by drv_owner_iface, which does not depend on the first BSS of
+ * the MLD or the first BSS of the driver still being present.
+ */
+static void hostapd_remove_drv_borrowers(struct hostapd_iface *iface)
+{
+#ifdef CONFIG_IEEE80211BE
+	struct hapd_interfaces *interfaces = iface->interfaces;
+	size_t j, k;
+
+	if (!interfaces || !iface->num_bss || !iface->bss[0]->drv_priv ||
+	    iface->bss[0]->conf->mld_ap)
+		return;
+
+	for (j = 0; j < interfaces->count; j++) {
+		struct hostapd_iface *other = interfaces->iface[j];
+
+		/* Slots are set to NULL during process shutdown */
+		if (!other || other == iface || !other->num_bss)
+			continue;
+
+		if (other->bss[0]->drv_priv &&
+		    other->bss[0]->drv_owner_iface == iface) {
+			wpa_printf(MSG_INFO,
+				   "Disable interface %s: its first BSS uses the driver of %s that is being deinitialized",
+				   other->bss[0]->conf->iface,
+				   iface->bss[0]->conf->iface);
+			hostapd_disable_iface(other);
+			continue;
+		}
+
+		/* Walk backwards: hostapd_remove_bss() shifts the following
+		 * entries down. */
+		for (k = other->num_bss; k > 1; k--) {
+			struct hostapd_data *hapd = other->bss[k - 1];
+
+			if (!hapd->drv_priv || hapd->drv_owner_iface != iface)
+				continue;
+
+			wpa_printf(MSG_INFO,
+				   "Remove BSS %s (AP MLD link %d) of interface %s: it uses the driver of %s that is being deinitialized",
+				   hapd->conf->iface, hapd->mld_link_id,
+				   other->bss[0]->conf->iface,
+				   iface->bss[0]->conf->iface);
+			hostapd_remove_bss(other, k - 1);
+		}
+	}
+#endif /* CONFIG_IEEE80211BE */
+}
+
+
 static void hostapd_cleanup_driver(const struct wpa_driver_ops *driver,
 				   void *drv_priv, struct hostapd_iface *iface)
 {
@@ -3524,22 +3615,29 @@
 		return;
 
 #ifdef CONFIG_IEEE80211BE
-	/* In case of non-ML operation, de-init. But if ML operation exist,
-	 * even if that's the last BSS in the interface, the driver (drv) could
-	 * be in use for a different AP MLD. Hence, need to check if drv is
-	 * still being used by some other BSS before de-initiallizing. */
-	if (!iface->bss[0]->conf->mld_ap) {
-		driver->hapd_deinit(drv_priv);
-	} else if (hostapd_mld_is_first_bss(iface->bss[0]) &&
-		   driver->is_drv_shared &&
-		   !driver->is_drv_shared(drv_priv,
-					  iface->bss[0]->mld_link_id)) {
+	/* Even if that's the last BSS in the interface, the driver (drv) could
+	 * be in use for a different AP MLD, whether or not the first BSS of
+	 * this interface is an AP MLD link. Hence, need to check if drv is
+	 * still being used by some other BSS before de-initializing. */
+	if (!driver->is_drv_shared ||
+	    !driver->is_drv_shared(drv_priv, iface->bss[0]->mld_link_id)) {
 		driver->hapd_deinit(drv_priv);
 		hostapd_mld_interface_freed(iface->bss[0]);
-	} else if (hostapd_if_link_remove(iface->bss[0],
-					  WPA_IF_AP_BSS,
-					  iface->bss[0]->conf->iface,
-					  iface->bss[0]->mld_link_id)) {
+		iface->bss[0]->drv_priv = NULL;
+		iface->bss[0]->drv_owner_iface = NULL;
+		return;
+	}
+
+	if (iface->bss[0]->conf->mld_ap) {
+		if (hostapd_if_link_remove(iface->bss[0],
+					   WPA_IF_AP_BSS,
+					   iface->bss[0]->conf->iface,
+					   iface->bss[0]->mld_link_id))
+			wpa_printf(MSG_WARNING,
+				   "Failed to remove link BSS interface %s",
+				   iface->bss[0]->conf->iface);
+	} else if (hostapd_if_remove(iface->bss[0], WPA_IF_AP_BSS,
+				     iface->bss[0]->conf->iface)) {
 		wpa_printf(MSG_WARNING, "Failed to remove BSS interface %s",
 			   iface->bss[0]->conf->iface);
 	}
@@ -3547,6 +3645,7 @@
 	driver->hapd_deinit(drv_priv);
 #endif /* CONFIG_IEEE80211BE */
 	iface->bss[0]->drv_priv = NULL;
+	iface->bss[0]->drv_owner_iface = NULL;
 }
 
 
@@ -3558,6 +3657,7 @@
 	wpa_printf(MSG_DEBUG, "%s(%p)", __func__, iface);
 	if (iface == NULL)
 		return;
+	hostapd_remove_drv_borrowers(iface);
 	wpa_printf(MSG_DEBUG, "%s: num_bss=%u conf->num_bss=%u",
 		   __func__, (unsigned int) iface->num_bss,
 		   (unsigned int) iface->conf->num_bss);
@@ -3589,6 +3689,7 @@
 				   hapd_iface->bss[j]->drv_priv);
 			if (hapd_iface->bss[j]->drv_priv == drv_priv) {
 				hapd_iface->bss[j]->drv_priv = NULL;
+				hapd_iface->bss[j]->drv_owner_iface = NULL;
 				hapd_iface->extended_capa = NULL;
 				hapd_iface->extended_capa_mask = NULL;
 				hapd_iface->extended_capa_len = 0;
@@ -3606,7 +3707,8 @@
 		return;
 
 	for (j = 0; j < hapd_iface->interfaces->count; j++) {
-		if (hapd_iface->interfaces->iface[j] == hapd_iface)
+		if (!hapd_iface->interfaces->iface[j] ||
+		    hapd_iface->interfaces->iface[j] == hapd_iface)
 			continue;
 
 		ieee802_11_update_beacons(hapd_iface->interfaces->iface[j]);
@@ -3724,6 +3826,8 @@
 		hostapd_cleanup_cs_params(hapd_iface->bss[j]);
 #endif /* NEED_AP_MLME */
 
+	hostapd_remove_drv_borrowers(hapd_iface);
+
 	/* same as hostapd_interface_deinit without deinitializing ctrl-iface */
 	for (j = 0; j < hapd_iface->num_bss; j++) {
 		struct hostapd_data *hapd = hapd_iface->bss[j];
@@ -3919,6 +4023,8 @@
 			hapd = hapd_iface->bss[hapd_iface->num_bss - 1];
 			hapd->driver = hapd_iface->bss[0]->driver;
 			hapd->drv_priv = hapd_iface->bss[0]->drv_priv;
+			hapd->drv_owner_iface =
+				hapd_iface->bss[0]->drv_owner_iface;
 			os_memcpy(hapd->own_addr, hapd_iface->bss[0]->own_addr,
 				  ETH_ALEN);
 
@@ -5109,8 +5215,10 @@
 	if (!hapd || !hapd->conf->mld_ap)
 		return;
 
-	for_each_mld_link(link_bss, hapd)
+	for_each_mld_link(link_bss, hapd) {
 		link_bss->drv_priv = NULL;
+		link_bss->drv_owner_iface = NULL;
+	}
 }
 
 #endif /* CONFIG_IEEE80211BE */
diff --git a/src/ap/hostapd.h b/src/ap/hostapd.h
--- a/src/ap/hostapd.h
+++ b/src/ap/hostapd.h
@@ -214,6 +214,11 @@
 
 	const struct wpa_driver_ops *driver;
 	void *drv_priv;
+	/* Interface whose driver_init() created the driver behind drv_priv
+	 * and whose driver cleanup frees it; NULL for a driver that hostapd
+	 * does not own (wpa_supplicant AP/mesh mode). Only meaningful while
+	 * drv_priv is set. */
+	struct hostapd_iface *drv_owner_iface;
 
 	void (*new_assoc_sta_cb)(struct hostapd_data *hapd,
 				 struct sta_info *sta, int reassoc);
