+/**
+ * hostapd_mld_reattach_partners - Bring back the AP MLD partners taken down
+ * for a departed driver owner once their AP MLD has a first BSS again
+ * @eloop_ctx: struct hapd_interfaces *
+ * @timeout_ctx: Not used
+ *
+ * hostapd_remove_drv_borrowers() disables an interface whose first BSS is an
+ * AP MLD link borrowing the driver of an interface that goes away
+ * (mld_partner_disabled) and parks the configuration of every secondary AP
+ * MLD link BSS that borrows it (mld_parked_bss). Once a first BSS of the same
+ * AP MLD runs again with a driver of its own, these can borrow that context as
+ * they did before: enable the interface, which runs driver_init() and the
+ * interface setup on its unchanged configuration, and add each parked BSS
+ * back to its still running interface. A parked BSS whose re-add fails stays
+ * parked. An explicit disable or removal revokes both
+ * (hostapd_mld_revoke_recovery()).
+ */
+static void hostapd_mld_reattach_partners(void *eloop_ctx, void *timeout_ctx)
+{
+	struct hapd_interfaces *interfaces = eloop_ctx;
+	size_t i, k;
+
+	for (i = 0; i < interfaces->count; i++) {
+		struct hostapd_iface *iface = interfaces->iface[i];
+		struct hostapd_data *hapd;
+
+		if (!iface || !iface->num_bss)
+			continue;
+		hapd = iface->bss[0];
+
+		if (iface->mld_partner_disabled) {
+			if (iface->state != HAPD_IFACE_DISABLED ||
+			    hapd->drv_priv || !hapd->conf->mld_ap) {
+				/* Enabled meanwhile: nothing to do */
+				iface->mld_partner_disabled = 0;
+			} else if (hostapd_mld_running_first_bss(
+					   interfaces, hapd->conf->iface)) {
+				wpa_printf(MSG_INFO,
+					   "Re-enable interface %s: the AP MLD it borrows its driver from has a first BSS again",
+					   hapd->conf->iface);
+				iface->mld_partner_disabled = 0;
+				if (hostapd_enable_iface(iface))
+					wpa_printf(MSG_WARNING,
+						   "Failed to re-enable interface %s",
+						   hapd->conf->iface);
+			}
+		}
+
+		/* Parked secondaries need their own interface running */
+		if (!iface->num_mld_parked_bss || !hapd->drv_priv ||
+		    iface->state != HAPD_IFACE_ENABLED)
+			continue;
+
+		for (k = iface->num_mld_parked_bss; k > 0; k--) {
+			struct hostapd_mld_parked_bss p =
+				iface->mld_parked_bss[k - 1];
+			struct hostapd_data *fbss;
+			size_t m;
+
+			if (hostapd_mld_parked_bss_is_live(interfaces, iface,
+							   &p)) {
+				hostapd_mld_drop_parked_bss_idx(
+					iface, k - 1, "supplied again");
+				continue;
+			}
+			fbss = hostapd_mld_running_first_bss(interfaces,
+							     p.conf->iface);
+			if (!fbss)
+				continue;
+
+			/* Off the list while it is added; it goes back to the
+			 * end of the list if that fails. */
+			iface->num_mld_parked_bss--;
+			for (m = k - 1; m < iface->num_mld_parked_bss; m++)
+				iface->mld_parked_bss[m] =
+					iface->mld_parked_bss[m + 1];
+			if (hostapd_mld_unpark_bss(iface, &p, fbss))
+				hostapd_mld_park_record(iface, &p);
+		}
+		hostapd_mld_parked_bss_changed(iface);
+	}
+}
