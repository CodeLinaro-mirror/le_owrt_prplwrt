+++ b/hostapd/hostapd.conf
@@ -7,6 +7,15 @@
 # command line parameter.
 interface=wlan0
 
+# Name of the PHY (radio), e.g. phy0.0 - in case of multi radio device,
+# to bind this interface to. Only needed when hostapd is started directly
+# from this config file and the PHY cannot be determined from the
+# netdev (interface) itself, e.g. on multi-radio setups.
+# When hostapd is started via the control interface ADD_IFACE command,
+# the phy name supplied there takes precedence and this option is not needed.
+# (default: not set; PHY is queried from the driver)
+#phy_id=phy0
+#
 # In case of atheros and nl80211 driver interfaces, an additional
 # configuration parameter, bridge, may be used to notify hostapd if the
 # interface is included in a bridge. This parameter is not used with Host AP
