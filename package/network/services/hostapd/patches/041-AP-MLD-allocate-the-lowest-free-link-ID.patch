From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Petr=20=C5=A0tetiar?= <petr.stetiar@prplfoundation.org>
Date: Sun, 27 Sep 2026 09:30:00 +0200
Subject: [PATCH] AP MLD: allocate the lowest free link ID
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

hostapd_bss_alloc_link_id() hands a BSS that joins an AP MLD the next
value of a counter that only grows: hostapd_mld_remove_link() releases
nothing, and the only reuse is the parked re-add of 035. An AP MLD lives
as long as a BSS references it, and the partner first BSSes 035 keeps on
the other radios while their owner is down do, so every removal and
re-add of the owner BSS, and every REMOVE/ADD of a partner interface by
the controller, consumes another ID. After about fifteen of them hostapd
asks the driver for link 15 of an AP MLD whose IDs run from 0 to 14
(MAX_NUM_MLD_LINKS), the kernel rejects it:

  MLD: Failed to add link 15 in MLD wlan0.1

the interface goes DISABLED and pWHM restarts hostapd. Seen on build-20
in run-47b b02 and run-47c c02.

Assign the lowest link ID the AP MLD does not hold instead. An ID is
held by every BSS that is a link of the AP MLD, whether it runs, was
disabled by 035 or is not started yet (the BSSes of an interface being
set up are counted before they are allocated and checked on their own
where the interface is not registered yet; the BSS being assigned is not
linked to the AP MLD yet and does not count), and by every parked BSS
whose configuration names the AP MLD, so that a parked BSS comes back
under the ID and control socket name it had: hostapd_mld_unpark_bss()
only restores it, its record is off the list while it is re-added. The
IDs are derived from the objects that hold them, so no free path has to
release one, and the counter goes away.

When all fifteen IDs are held, hostapd_bss_setup_multi_link() fails and
its callers give the BSS up before a link control socket is published
or the driver is asked for a link. A new AP MLD takes the ID before it
binds its control socket, and one that fails afterwards is closed again
before it is freed: its read callback has it as context, and
hostapd_cleanup_unused_mlds() does not know it yet. An interface whose
later BSS fails frees the BSSes it allocated and drops their AP MLD
references, and the AP MLDs left without one are freed once the
interface is not registered: by hostapd_init() itself, by the caller of
hostapd_data_alloc(). Both were leaking them already on an allocation
failure; a parked BSS stays parked.

Signed-off-by: Petr Štetiar <petr.stetiar@prplfoundation.org>
---
 hostapd/main.c   |   5 ++-
 src/ap/hostapd.c | 182 +++++++++++++++++++++++++++++++++++++++++++++++++++++++--------------------
 src/ap/hostapd.h |   5 +--
 3 files changed, 138 insertions(+), 54 deletions(-)

diff --git a/hostapd/main.c b/hostapd/main.c
index ade8503ee096..fbc05b1ad9ac 100644
--- a/hostapd/main.c
+++ b/hostapd/main.c
@@ -169,8 +169,9 @@ static int hostapd_driver_init(struct hostapd_iface *iface)
 
 #ifdef CONFIG_IEEE80211BE
 	if (conf->mld_ap) {
-		if (!hapd->mld)
-			hostapd_bss_setup_multi_link(hapd, iface->interfaces);
+		if (!hapd->mld &&
+		    hostapd_bss_setup_multi_link(hapd, iface->interfaces))
+			return -1;
 		h_hapd = hostapd_mld_get_first_bss(hapd);
 	}
 
diff --git a/src/ap/hostapd.c b/src/ap/hostapd.c
index 7355ff6dee54..390f08a4ae27 100644
--- a/src/ap/hostapd.c
+++ b/src/ap/hostapd.c
@@ -78,6 +78,10 @@ static void hostapd_mld_drop_parked_bss(struct hostapd_iface *iface,
 					const char *reason);
 static void hostapd_mld_drop_resupplied_parked_bss(struct hostapd_iface *iface);
 static void hostapd_mld_reconcile_parked_bss(struct hostapd_iface *iface);
+static bool hostapd_iface_link_id_in_use(struct hostapd_iface *iface,
+					 struct hostapd_mld *mld, u8 link_id);
+static bool hostapd_mld_link_id_in_use(struct hapd_interfaces *interfaces,
+				       struct hostapd_mld *mld, u8 link_id);
 #endif /* CONFIG_IEEE80211BE */
 static int hostapd_disable_iface_int(struct hostapd_iface *hapd_iface);
 #ifdef CONFIG_IEEE80211AX
@@ -3217,17 +3221,35 @@ struct hostapd_iface * hostapd_alloc_iface(void)
 
 
 #ifdef CONFIG_IEEE80211BE
-static void hostapd_bss_alloc_link_id(struct hostapd_data *hapd)
+/* Assign hapd the lowest link ID no BSS of AP MLD mld holds: live, disabled,
+ * not started yet or parked. hapd is not a link of mld yet and does not
+ * count; its interface may not be registered yet and is checked on its own. */
+static int hostapd_bss_alloc_link_id(struct hostapd_data *hapd,
+				     struct hostapd_mld *mld,
+				     struct hapd_interfaces *interfaces)
 {
-	hapd->mld_link_id = hapd->mld->next_link_id++;
-	wpa_printf(MSG_DEBUG, "AP MLD: %s: Link ID %d assigned.",
-		   hapd->mld->name, hapd->mld_link_id);
+	u8 link_id;
+
+	for (link_id = 0; link_id < MAX_NUM_MLD_LINKS; link_id++) {
+		if (hostapd_mld_link_id_in_use(interfaces, mld, link_id) ||
+		    hostapd_iface_link_id_in_use(hapd->iface, mld, link_id))
+			continue;
+		hapd->mld_link_id = link_id;
+		wpa_printf(MSG_DEBUG, "AP MLD: %s: Link ID %d assigned.",
+			   mld->name, hapd->mld_link_id);
+		return 0;
+	}
+
+	wpa_printf(MSG_ERROR,
+		   "AP MLD: %s: no link ID left for BSS %s, all %d are in use",
+		   mld->name, hapd->conf->iface, MAX_NUM_MLD_LINKS);
+	return -1;
 }
 #endif /* CONFIG_IEEE80211BE */
 
 
-void hostapd_bss_setup_multi_link(struct hostapd_data *hapd,
-				  struct hapd_interfaces *interfaces)
+int hostapd_bss_setup_multi_link(struct hostapd_data *hapd,
+				 struct hapd_interfaces *interfaces)
 {
 #ifdef CONFIG_IEEE80211BE
 	struct hostapd_mld *mld, **all_mld;
@@ -3238,7 +3260,7 @@ void hostapd_bss_setup_multi_link(struct hostapd_data *hapd,
 
 	if (!hapd->iconf || !hapd->iconf->ieee80211be || !conf->mld_ap ||
 	    conf->disable_11be)
-		return;
+		return 0;
 
 	for (i = 0; i < interfaces->mld_count; i++) {
 		mld = interfaces->mld[i];
@@ -3246,53 +3268,64 @@ void hostapd_bss_setup_multi_link(struct hostapd_data *hapd,
 		if (!mld || os_strcmp(conf->iface, mld->name) != 0)
 			continue;
 
+		if (hostapd_bss_alloc_link_id(hapd, mld, interfaces))
+			return -1;
 		hapd->mld = mld;
 		hostapd_mld_ref_inc(mld);
-		hostapd_bss_alloc_link_id(hapd);
 		break;
 	}
 
 	if (hapd->mld)
-		return;
+		return 0;
 
 	mld = os_zalloc(sizeof(struct hostapd_mld));
 	if (!mld)
-		goto fail;
+		return -1;
 
 	os_strlcpy(mld->name, conf->iface, sizeof(conf->iface));
 	dl_list_init(&mld->links);
+	dl_list_init(&mld->ctrl_dst);
 	mld->ctrl_sock = -1;
-	if (hapd->conf->ctrl_interface)
+	if (hapd->conf->ctrl_interface) {
 		mld->ctrl_interface = os_strdup(hapd->conf->ctrl_interface);
+		if (!mld->ctrl_interface)
+			goto fail;
+	}
 
 	wpa_printf(MSG_DEBUG, "AP MLD %s created", mld->name);
 
+	/* Before the control socket: no endpoint for an AP MLD the BSS cannot
+	 * join. The parked BSSes that name the AP MLD hold its IDs already. */
+	if (hostapd_bss_alloc_link_id(hapd, mld, interfaces))
+		goto fail;
+
 	/* Initialize MLD control interfaces early to allow external monitoring
 	 * of link setup operations. */
 	if (interfaces->mld_ctrl_iface_init(mld))
 		goto fail;
 
-	hapd->mld = mld;
-	hostapd_mld_ref_inc(mld);
-	hostapd_bss_alloc_link_id(hapd);
-
 	all_mld = os_realloc_array(interfaces->mld, interfaces->mld_count + 1,
 				   sizeof(struct hostapd_mld *));
 	if (!all_mld)
 		goto fail;
 
+	hapd->mld = mld;
+	hostapd_mld_ref_inc(mld);
 	interfaces->mld = all_mld;
 	interfaces->mld[interfaces->mld_count] = mld;
 	interfaces->mld_count++;
 
-	return;
+	return 0;
 fail:
-	if (!mld)
-		return;
-
+	/* Not in interfaces->mld yet, so hostapd_cleanup_unused_mlds() would
+	 * not find it: close its control socket, whose read callback has it
+	 * as context, and free it here. */
 	wpa_printf(MSG_DEBUG, "AP MLD %s: free mld %p", mld->name, mld);
+	interfaces->mld_ctrl_iface_deinit(mld);
 	os_free(mld);
-	hapd->mld = NULL;
+	return -1;
+#else /* CONFIG_IEEE80211BE */
+	return 0;
 #endif /* CONFIG_IEEE80211BE */
 }
 
@@ -3377,6 +3410,27 @@ static void hostapd_cleanup_unused_mlds(struct hapd_interfaces *interfaces)
 }
 
 
+/* Free the BSSes of an interface whose setup failed before any of them was
+ * started: they were allocated by hostapd_alloc_bss_data() and at most
+ * joined an AP MLD. The AP MLDs left without a reference are for
+ * hostapd_cleanup_unused_mlds() once the interface is not registered. */
+static void hostapd_free_unstarted_bss(struct hostapd_iface *iface)
+{
+	size_t i;
+
+	for (i = 0; iface->bss && i < iface->num_bss; i++) {
+#ifdef CONFIG_IEEE80211BE
+		if (iface->bss[i])
+			hostapd_mld_ref_dec(iface->bss[i]->mld);
+#endif /* CONFIG_IEEE80211BE */
+		os_free(iface->bss[i]);
+	}
+	os_free(iface->bss);
+	iface->bss = NULL;
+	iface->num_bss = 0;
+}
+
+
 /**
  * hostapd_init - Allocate and initialize per-interface data
  * @config_file: Path to the configuration file
@@ -3420,7 +3474,8 @@ struct hostapd_iface * hostapd_init(struct hapd_interfaces *interfaces,
 		if (hapd == NULL)
 			goto fail;
 		hapd->msg_ctx = hapd;
-		hostapd_bss_setup_multi_link(hapd, interfaces);
+		if (hostapd_bss_setup_multi_link(hapd, interfaces))
+			goto fail;
 	}
 
 	hapd_iface->is_ch_switch_dfs = false;
@@ -3432,8 +3487,10 @@ fail:
 	if (conf)
 		hostapd_config_free(conf);
 	if (hapd_iface) {
+		/* Not registered: the AP MLDs its BSSes joined are unused now */
+		hostapd_free_unstarted_bss(hapd_iface);
+		hostapd_cleanup_unused_mlds(interfaces);
 		os_free(hapd_iface->config_fname);
-		os_free(hapd_iface->bss);
 		wpa_printf(MSG_DEBUG, "%s: free iface %p",
 			   __func__, hapd_iface);
 		os_free(hapd_iface);
@@ -3831,7 +3888,13 @@ hostapd_interface_init_bss(struct hapd_interfaces *interfaces, const char *phy,
 		iface->conf->last_bss = bss;
 		iface->bss[iface->num_bss] = hapd;
 		hapd->msg_ctx = hapd;
-		hostapd_bss_setup_multi_link(hapd, interfaces);
+		if (hostapd_bss_setup_multi_link(hapd, interfaces)) {
+			iface->bss[iface->num_bss] = NULL;
+			os_free(hapd);
+			iface->conf->num_bss--;
+			hostapd_config_free(conf);
+			return NULL;
+		}
 
 
 		bss_idx = iface->num_bss++;
@@ -4138,19 +4201,44 @@ static bool hostapd_mld_parked_bss_mld_ok(const struct hostapd_mld_parked_bss *p
 }
 
 
+/* Whether link ID link_id of AP MLD mld is held by a BSS of iface, in
+ * whatever state (a BSS being set up may not be allocated yet), or by a
+ * parked BSS of iface. A parked BSS names its AP MLD, whose hostapd_mld may
+ * have been freed and created again meanwhile. */
+static bool hostapd_iface_link_id_in_use(struct hostapd_iface *iface,
+					 struct hostapd_mld *mld, u8 link_id)
+{
+	size_t i;
+
+	for (i = 0; iface->bss && i < iface->num_bss; i++) {
+		struct hostapd_data *hapd = iface->bss[i];
+
+		if (hapd && hapd->mld == mld && hapd->mld_link_id == link_id)
+			return true;
+	}
+	for (i = 0; i < iface->num_mld_parked_bss; i++) {
+		const struct hostapd_mld_parked_bss *p =
+			&iface->mld_parked_bss[i];
+
+		if (p->link_id == link_id &&
+		    os_strcmp(p->conf->iface, mld->name) == 0)
+			return true;
+	}
+
+	return false;
+}
+
+
 static bool hostapd_mld_link_id_in_use(struct hapd_interfaces *interfaces,
 				       struct hostapd_mld *mld, u8 link_id)
 {
-	size_t i, j;
+	size_t i;
 
 	for (i = 0; i < interfaces->count; i++) {
-		struct hostapd_iface *iface = interfaces->iface[i];
-
-		for (j = 0; iface && j < iface->num_bss; j++) {
-			if (iface->bss[j]->mld == mld &&
-			    iface->bss[j]->mld_link_id == link_id)
-				return true;
-		}
+		if (interfaces->iface[i] &&
+		    hostapd_iface_link_id_in_use(interfaces->iface[i], mld,
+						 link_id))
+			return true;
 	}
 
 	return false;
@@ -4420,15 +4508,12 @@ static int hostapd_mld_unpark_bss(struct hostapd_iface *iface,
 	}
 
 	/* Keep the link ID the BSS had, so that it comes back under its
-	 * previous control socket name, unless the AP MLD reused it. */
+	 * previous control socket name. Its parked record held the ID until
+	 * it was taken off the list for this re-add, so the ID is free unless
+	 * hostapd_bss_setup_multi_link() just assigned it to this very BSS. */
 	if (p->link_id < MAX_NUM_MLD_LINKS &&
-	    !hostapd_mld_link_id_in_use(iface->interfaces, mld, p->link_id)) {
-		if (mld->next_link_id == hapd->mld_link_id + 1)
-			mld->next_link_id--;
+	    !hostapd_mld_link_id_in_use(iface->interfaces, mld, p->link_id))
 		hapd->mld_link_id = p->link_id;
-		if (mld->next_link_id <= p->link_id)
-			mld->next_link_id = p->link_id + 1;
-	}
 
 	/* The link comes back under the address it had, or the one its
 	 * configuration names, and never under an automatic one: that would
@@ -5068,26 +5153,25 @@ static int hostapd_data_alloc(struct hostapd_iface *hapd_iface,
 				    sizeof(struct hostapd_data *));
 	if (hapd_iface->bss == NULL)
 		return -1;
+	/* Counted before they are allocated, so that a later BSS of the same AP
+	 * MLD sees the link IDs of the earlier ones; empty slots are skipped */
+	hapd_iface->num_bss = conf->num_bss;
 
 	for (i = 0; i < conf->num_bss; i++) {
 		hapd = hapd_iface->bss[i] =
 			hostapd_alloc_bss_data(hapd_iface, conf, conf->bss[i]);
-		if (hapd == NULL) {
-			while (i > 0) {
-				i--;
-				os_free(hapd_iface->bss[i]);
-				hapd_iface->bss[i] = NULL;
-			}
-			os_free(hapd_iface->bss);
-			hapd_iface->bss = NULL;
+		if (hapd)
+			hapd->msg_ctx = hapd;
+		if (hapd == NULL ||
+		    hostapd_bss_setup_multi_link(hapd, hapd_iface->interfaces)) {
+			/* The caller unregisters the interface and frees the
+			 * AP MLDs left without a reference */
+			hostapd_free_unstarted_bss(hapd_iface);
 			return -1;
 		}
-		hapd->msg_ctx = hapd;
-		hostapd_bss_setup_multi_link(hapd, hapd_iface->interfaces);
 	}
 
 	hapd_iface->conf = conf;
-	hapd_iface->num_bss = conf->num_bss;
 
 	return 0;
 }
diff --git a/src/ap/hostapd.h b/src/ap/hostapd.h
index 1b6625fb735b..b4bf3ad08bfc 100644
--- a/src/ap/hostapd.h
+++ b/src/ap/hostapd.h
@@ -540,7 +540,6 @@ struct hostapd_sta_info {
 struct hostapd_mld {
 	char name[IFNAMSIZ + 1];
 	u8 mld_addr[ETH_ALEN];
-	u8 next_link_id;
 	u8 num_links;
 	/* Number of hostapd_data (hapd) referencing this. num_links cannot be
 	 * used since num_links can go to 0 even when a BSS is disabled and
@@ -804,8 +803,8 @@ int hostapd_setup_interface(struct hostapd_iface *iface);
 int hostapd_setup_interface_complete(struct hostapd_iface *iface, int err);
 void hostapd_interface_deinit(struct hostapd_iface *iface);
 void hostapd_interface_free(struct hostapd_iface *iface);
-void hostapd_bss_setup_multi_link(struct hostapd_data *hapd,
-				  struct hapd_interfaces *interfaces);
+int hostapd_bss_setup_multi_link(struct hostapd_data *hapd,
+				 struct hapd_interfaces *interfaces);
 struct hostapd_iface * hostapd_alloc_iface(void);
 struct hostapd_iface * hostapd_init(struct hapd_interfaces *interfaces,
 				    const char *config_file);
